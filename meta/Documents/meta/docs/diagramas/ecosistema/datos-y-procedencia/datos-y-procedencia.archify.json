  "cards": [
    {
      "dot": "cyan",
      "title": "Procedencia en el origen",
      "items": [
        "Todo lo adquirido registra URL, fecha y SHA-256 antes de tocar nada más",
        "data/raw guarda el archivo original y no se reescribe nunca",
        "Los documentos se catalogan en Calibre; data/raw solo guarda datos"
      ]
    },
    {
      "dot": "emerald",
      "title": "Una autoridad por concepto",
      "items": [
        "Calibre manda sobre los campos bibliográficos; Zotero es su espejo de las 04:30",
        "calibre_id · zotero_key · clave_bibtex · ko_md5 unen los almacenes sin copiarlos",
        "KOReader nunca recibe escrituras; los microdatos restringidos no salen"
      ]
    }
  ]
