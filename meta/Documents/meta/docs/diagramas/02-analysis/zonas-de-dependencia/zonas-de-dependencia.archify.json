  "cards": [
    {
      "dot": "cyan",
      "title": "Adquisición — Fase 01",
      "items": [
        "Un conector = una institución, nunca un mecanismo",
        "Protocolo estándar: motor en _lib + config.py por agencia",
        "connectors/_lib solo usa la stdlib: corre sin instalar nada",
        "institution es vocabulario controlado en _lib/instituciones.py"
      ]
    },
    {
      "dot": "emerald",
      "title": "Procesamiento — Fases 02 a 12",
      "items": [
        "Cadena de capas: raw → audited → clean → harmonized → integrated",
        "Ninguna fase sobrescribe la capa anterior",
        "La Fase 03 escribe la tabla metadatos en el mismo catálogo",
        "Requiere pandas · numpy · scipy · statsmodels"
      ]
    },
    {
      "dot": "rose",
      "title": "Reglas duras",
      "items": [
        "El archivo original en data/raw es sagrado",
        "Los documentos de consulta viven en Calibre, no en data/raw",
        "No redistribuir microdatos restringidos: data/ nunca es público",
        "Ninguna cifra sin fuente, periodo, unidad y publicación de respaldo"
      ]
    }
  ]
